# hh-server 配置模板 —— 复制为 server/.env 后填值（server/.env 已被 git 忽略）。
#   cp server/.env.example server/.env
# 读取优先级：进程环境变量 > server/.env > <repo>/.env > hospital_intel/.env（仅地理 key）。
# HH_ 前缀可以省略（写 AMAP_KEY=... 也认）。

# ---- 上游：Agent Service（大模型推理）：必填 ----
# 上游 Agent Service 地址。生产实测：https://ai.ei.ac.cn:7988
# 注意 scheme：上游是 https 端口却写 http:// 会稳定 502（Connection reset by peer）。
HH_AGENTSVC_BASE=http://localhost:7988
# 上游 https 且自签证书时设 1 跳过证书校验；/healthz 探上游用的只读路径
HH_AGENTSVC_INSECURE_TLS=0
HH_AGENTSVC_PROBE_PATH=/v1/models
HH_AGENTSVC_TOKEN=把 Agent Service 的 Bearer token 填这里
HH_AGENT_IDS=hospital_helper

# ---- 上游：地理位置：用高德就填 AMAP_KEY；换天地图则改 provider + 填 TIANDITU_KEY ----
HH_GEO_PROVIDER=amap
HH_AMAP_KEY=高德 Web 服务 API key
# HH_TIANDITU_KEY=天地图 tk

# ---- APK 发版口令（POST /v1/app/upload、/v1/app/remove 的 X-Admin-Token）----
# 留空 = 这两个接口直接 503 关闭（安全默认）。发版用随机串，别复用示例值。
HH_ADMIN_TOKEN=换成随机串

# ---- 其它可选项（默认值见 config.py）----
# HH_LISTEN_HOST=0.0.0.0
# HH_LISTEN_PORT=51120
# HH_TLS_CERT=<abs path>/hh.ei.ac.cn.pem
# HH_TLS_KEY=<abs path>/hh.ei.ac.cn.key
# HH_TLS_SELF_SIGNED=0
# HH_GEO_CRS=GCJ-02
# HH_GEO_CACHE_TTL=21600
# HH_APK_CHANNEL=debug
# HH_REQUEST_LOG=1
