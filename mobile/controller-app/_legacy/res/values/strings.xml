<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name">挂号控制器</string>
    <string name="service_label">挂号控制器 · 读屏桥</string>
    <string name="service_description">读取随申办页面节点并执行点击/滑动/输入（端上设备桥，替代 adb + uiautomator）</string>

    <!-- 区块标题 -->
    <string name="block_form">① 表单</string>
    <string name="block_log">② 实时日志</string>
    <string name="block_result">③ 结果</string>
    <string name="block_history">④ 历史</string>

    <!-- 表单字段 -->
    <string name="lbl_symptom">症状描述（必填）</string>
    <string name="hint_symptom">如：孩子反复咳嗽伴发热3天，希望1-2天内看到，不必非三甲</string>
    <string name="lbl_patient">就诊人（随申办 · 代他人挂号时留空）</string>
    <string name="lbl_fee">预期费用档（0=auto，由 LLM 从描述判断）</string>
    <string name="lbl_location">位置（地址文本）</string>
    <string name="hint_location">如：徐汇区宜山路600号</string>
    <string name="lbl_live">实时抓取 --live（端上设备桥，慢）</string>
    <string name="lbl_agentsvc">Agent Service base（可空 = 默认 PC 局域网 :7989）</string>
    <string name="hint_agentsvc">如 http://192.168.1.23:7989</string>
    <string name="hint_patient_note">P0–P2：就诊人下拉暂为占位（P3 接入读屏只读采集）</string>

    <!-- 按钮 -->
    <string name="btn_launch">唤起随申办</string>
    <string name="btn_dump">读屏（打印节点树 JSON）</string>
    <string name="btn_run">开始（哑回放：唤起→读屏）</string>
    <string name="btn_llm">测试 LLM（JSON 推理）</string>
    <string name="btn_clear_hist">清空历史</string>

    <!-- 状态 -->
    <string name="svc_ready">读屏服务：已连接</string>
    <string name="svc_missing">读屏服务：未授权 — 点此去系统设置开启</string>
    <string name="toast_need_service">请先在「无障碍」里开启“挂号控制器 · 读屏桥”</string>
    <string name="log_placeholder">（尚未运行）</string>
    <string name="result_placeholder">（尚无结果）</string>
    <string name="history_placeholder">（暂无历史）</string>
</resources>
