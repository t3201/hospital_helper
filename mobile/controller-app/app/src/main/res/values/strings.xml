<resources>
    <string name="app_name">挂号助手</string>
    <string name="service_label">挂号助手 · 读屏桥</string>
    <string name="service_description">读取随申办页面节点并执行点击/滑动/输入（端上设备桥，替代 adb + uiautomator）</string>

    <!-- 底部 Tab 标签 -->
    <string name="tab_form">挂号</string>
    <string name="tab_log">实时日志</string>
    <string name="tab_result">结果</string>
    <string name="tab_history">历史</string>
    <string name="tab_settings">设置</string>

    <!-- 表单字段 -->
    <string name="lbl_symptom">症状描述（必填）</string>
    <string name="hint_symptom">如：孩子反复咳嗽伴发热3天，希望1-2天内看到，不必非要三甲</string>
    <string name="lbl_location">位置（必填）</string>
    <string name="hint_location">如：徐汇区宜山路600号</string>
    <string name="btn_autoloc">📍 自动定位</string>
    <string name="hint_autoloc">读手机最后位置 → 高德逆地理成地址（已内置 key，点按钮实时读取）。</string>
    <string name="autoloc_ok">✓ 设备定位: </string>
    <string name="autoloc_fail">⚠ 自动定位失败: </string>
    <string name="autoloc_nokey">（未配 AMAP_KEY，仅坐标无地址）</string>
    <string name="lbl_slottype">号源子tab（仅勾选「AI代理实时读取」时生效）</string>
    <string name="slot_all">全部子tab（最全）</string>
    <string name="slot_expert">仅专家门诊（快速档）</string>
    <string name="slot_normal">仅普通门诊</string>
    <string name="slot_specialty">仅专病门诊</string>
    <string name="lbl_live_new">AI代理实时读取</string>
    <string name="hint_live_desc">实时读取随申办号源（较慢），耗时与候选集数量、号源子tab、预期费用档位相关；见下方估算。</string>
    <string name="lbl_est_time">预计耗时</string>
    <string name="est_idle">未勾选实时读取：约 10–60 秒（离线候选集，不含实时号源核实）</string>

    <!-- 设置：候选集 / 推荐数量 -->
    <string name="lbl_run_params">运行参数</string>
    <string name="lbl_cand_n">候选集数量（Phase A 快速探测的候选医院数，越大越全但越慢）</string>
    <string name="lbl_top_n">最终推荐科室数量（Phase B 深核 + 终榜行数，越大越慢）</string>
    <string name="lbl_patient">就诊人（代他人挂号时留空）</string>
    <string name="hint_patient_note">缓存永久有效（点「获取就诊人」才刷新）；首项 = 代他人挂号</string>
    <string name="btn_get_patients">👥 获取就诊人</string>
    <string name="lbl_fee">预期费用</string>

