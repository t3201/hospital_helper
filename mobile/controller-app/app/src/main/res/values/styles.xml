<?xml version="1.0" encoding="utf-8"?>
<!--
  HhSpinner：三个下拉（预期费用 / 号源子tab / 就诊人）用的原生 Spinner 外观。
  背景是 hh_spinner_bg（扁平字段底 + 右侧下拉箭头），保持和其它字段一致的观感。
-->
<resources>
    <style name="HhSpinner" parent="@android:style/Widget.Material.Light.Spinner">
        <item name="android:layout_height">46dp</item>
        <item name="android:background">@drawable/hh_spinner_bg</item>
        <item name="android:popupBackground">@android:color/white</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">30dp</item>
    </style>
</resources>
