<?xml version="1.0" encoding="utf-8"?>
<!-- Spinner 背景：扁平字段底 + 右侧下拉箭头（原生 Spinner 换背景后自身箭头会消失，
     所以把箭头画进背景里，禁用态由外层 formBody 的 alpha 统一压暗）。 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/hh_field" />
            <corners android:radius="6dp" />
        </shape>
    </item>
    <item
        android:width="18dp"
        android:height="18dp"
        android:drawable="@drawable/hh_arrow_down"
        android:end="8dp"
        android:gravity="end|center_vertical" />
</layer-list>
